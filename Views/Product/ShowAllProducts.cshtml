

<table class="table table-borderd table-hover">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Description</th>
            <th>Price</th>
            <th>Image</th>
            <th>Show Details</th>
        </tr>
    </thead>
    <tbody>
        @foreach (Product product in Model)
        {
            <tr>
                <td>@product.Id</td>
                <td>@product.Name</td>
                <td>@product.Description</td>
                <td>@product.Price.ToString("C")</td>
                <td>
                    <img src="/Images/@product.ImageUrl" alt="@product.Name" style="max-width: 100px; max-height: 60px;" />
                </td>
                <td>
                    <a  href="http://localhost:5057/Product/ProductDetails/@product.Id"><button class="btn btn-primary">Show Details</button></a>
                </td>
            </tr>
        }
    </tbody>